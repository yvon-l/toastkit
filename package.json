{
  "name": "toastkit",
  "private": true,
  "description": "Tests and packaging for the ToastKit browser extension. Not needed to use or load it.",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=60000 tests/*.test.mjs",
    "test:firefox": "node --test --test-concurrency=1 --test-timeout=120000 tests/firefox/*.test.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "selenium-webdriver": "4.54.0"
  }
}
